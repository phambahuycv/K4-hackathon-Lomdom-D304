# Tạo key mới sau khi thu hồi key từng bị commit trong frontend.
GEMINI_API_KEY=your_new_gemini_api_key

# Có thể đổi danh sách model mà không cần sửa code.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Các origin frontend được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
